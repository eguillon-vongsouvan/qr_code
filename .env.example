# Variables d'environnement — Émargement QR
# Copier ce fichier en ".env" et remplir TOUTES les valeurs

# ─── Sécurité obligatoire ───────────────────────────────────────────
# Secret pour signer les QR codes (min 32 chars, aléatoire)
QR_SECRET=

# Clé de chiffrement AES-256 pour la BDD (noms, emails) et les logs système.
# OBLIGATOIRE — exactement 32 caractères minimum, identique à chaque redémarrage Docker.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secret pour les cookies signés (min 32 chars, aléatoire)
COOKIE_SECRET=

# ─── Comptes par défaut (créés au premier démarrage si la BDD est vide) ──
# Ces mots de passe ne doivent être que temporaires (force_password_change=1)
ADMIN_PASSWORD=
PROF_PASSWORD=

# ─── Serveur ────────────────────────────────────────────────────────
# Port d'écoute (défaut: 3000)
PORT=3000

# ─── Déploiement Docker (Ubuntu) ────────────────────────────────────
# 1. Copier le projet : scp -r ./qr_code-main/* admin@SERVEUR:/home/admin/qr_code/
# 2. Sur le serveur : cp .env.example .env && nano .env  (remplir TOUTES les valeurs)
# 3. ENCRYPTION_KEY ne doit JAMAIS changer une fois la BDD créée
# 4. docker compose up -d --build
# 5. Lire les logs chiffrés : docker compose exec qr-app node tools/decrypt-logs.js

# URL publique si derrière un reverse proxy (laisser vide pour mode Wi-Fi local)
# Exemple: PUBLIC_URL=https://monsite.exemple.fr
PUBLIC_URL=

# ─── Géofencing (optionnel) ─────────────────────────────────────────
# Centre de la zone autorisée
# GEO_LAT=48.8566
# GEO_LNG=2.3522
# GEO_RADIUS_M=200
